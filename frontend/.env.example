# DevLens AI - Frontend Environment Configuration
# Copy this file to .env and adjust variables as needed for local development.

# Base URL for the Django REST Framework backend API
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# IMPORTANT SECURITY NOTE:
# Never put the GROQ_API_KEY or any secret credentials in the frontend.
# All AI interactions are securely proxied and handled by the Django backend.
