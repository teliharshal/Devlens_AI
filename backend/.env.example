# Django Core Settings
SECRET_KEY=generate-a-secure-random-secret-key-for-production
DEBUG=False
ALLOWED_HOSTS=.onrender.com,127.0.0.1,localhost
# RENDER_EXTERNAL_HOSTNAME is set automatically by Render in production
# RENDER_EXTERNAL_HOSTNAME=your-backend.onrender.com

# Database Settings
# On Render, linking a PostgreSQL instance automatically sets DATABASE_URL.
# When DATABASE_URL is set, dj-database-url is used automatically.
DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# Local PostgreSQL Fallback (used only if DATABASE_URL is not provided)
DB_NAME=devlens_db
DB_USER=postgres
DB_PASSWORD=your_local_password
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
# Set FRONTEND_URL to your deployed React/Vite domain (e.g. https://devlens-ai.vercel.app)
FRONTEND_URL=https://your-frontend-app.vercel.app

# Groq AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
